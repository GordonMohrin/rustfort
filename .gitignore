/target
**/target
# DF data never goes into the repo: exports of real saves, copied raws, graphics
/export/
/dfdata/
*.dfexport
*.sav
*.png.cache
# Screenshots (screenshot tests, --screenshot runs); only the README's pictures are tracked
*.png
!/docs/screenshots/*.png
*.bak
.claude/
# Saves, settings (saves/settings.json: DF folder, UI scale, ...) and crash logs are local
/saves/
saves/
*.rfsave
*.rfsave.bak
crash.log
